{
  "productName": "Video Translator",
  "version": "1.0.0",
  "identifier": "com.video-translator.app",
  "build": {
    "frontendDist": "frontend/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Video Translator",
        "width": 1000,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "copyright": "Copyright © 2024 Video Translator",
    "category": "Utility",
    "shortDescription": "Video Translator",
    "longDescription": "Translate and dub English IT videos into Chinese."
  }
}
